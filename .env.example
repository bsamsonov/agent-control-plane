# Postgres: admin URL runs migrations, APP url is the RLS-constrained app role.
DATABASE_URL_ADMIN=postgres://macp:macp@localhost:5433/macp
DATABASE_URL=postgres://macp_app:macp_app@localhost:5433/macp

# Envelope key for tenant_credentials (32 bytes, base64). Demo value only.
MACP_MASTER_KEY=ZGVtby1vbmx5LW1hc3Rlci1rZXktMzJieXRlcy0hIQ== # gitleaks:allow

# Real LLM mode: any OpenAI-compatible endpoint that supports JSON schema output
# (OpenAI, vLLM, an LLM gateway). Not needed when MACP_FAKE_LLM=1.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Set to 1 to run agents deterministically without any LLM call (used by tests/demo).
MACP_FAKE_LLM=1

CONTROL_PLANE_PORT=3001
# Origin(s) of the web UI allowed by CORS, comma-separated.
MACP_WEB_ORIGIN=http://localhost:3000
MCP_CRM_URL=http://localhost:3101/mcp
MCP_ESP_URL=http://localhost:3102/mcp
MCP_ANALYTICS_URL=http://localhost:3103/mcp
MCP_SEGMENT_URL=http://localhost:3104/mcp
